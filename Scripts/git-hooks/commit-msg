#!/usr/bin/env bash
set -euo pipefail

message_file="$1"
subject="$(head -n 1 "$message_file")"

conventional_subject='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([A-Za-z0-9._/-]+\))?!?: .+'
merge_subject='^Merge (branch|remote-tracking branch) '
ai_attribution='co-authored-by:.*(claude|anthropic|openai|chatgpt|copilot|gemini|cursor)|generated (with|by) (claude|chatgpt|copilot|gemini|cursor|\[claude)'

if ! [[ "$subject" =~ $conventional_subject || "$subject" =~ $merge_subject ]]; then
    printf 'commit-msg: the subject must follow Conventional Commits, for example "feat(TunnelConfiguration): parse AllowedIPs"\n' >&2
    exit 1
fi

if grep -Eiq "$ai_attribution" "$message_file"; then
    printf 'commit-msg: AI assistants must not be credited as authors or co-authors\n' >&2
    exit 1
fi
