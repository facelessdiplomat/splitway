      }
    },
    "Category" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Категория"
          }
        }
      }
    },
    "Choose at least one service, or no traffic will use the tunnel." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите хотя бы один сервис, иначе через туннель ничего не пойдёт."
