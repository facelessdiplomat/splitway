{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ appears more than once." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ указан больше одного раза."
          }
        }
      }
    },
    "%@ belongs to AmneziaWG, which is not supported yet." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ относится к AmneziaWG, который пока не поддерживается."
          }
        }
      }
    },
    "%@ is a wg-quick setting and will be ignored." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — параметр wg-quick, он будет пропущен."
          }
        }
      }
    },
    "%@ is not allowed in this section." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ нельзя указывать в этой секции."
          }
        }
      }
    },
    "%@ is outside any section." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ находится вне секции."
          }
        }
      }
    },
    "A peer has no allowed IPs." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У пира нет разрешённых IP (AllowedIPs)."
          }
        }
      }
    },
    "A peer has no public key." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У пира нет публичного ключа."
          }
        }
      }
    },
    "A peer uses the public key of this interface." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пир использует публичный ключ этого интерфейса."
          }
        }
      }
    },
    "Enter DNS servers or search domains, separated by commas." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите DNS-серверы или домены поиска через запятую."
          }
        }
      }
    },
    "Enter a 44-character base64 key." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите ключ base64 из 44 символов."
          }
        }
      }
    },
    "Enter a host and port, like vpn.example.com:51820." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите хост и порт, например vpn.example.com:51820."
          }
        }
      }
    },
    "Enter a port from %@ to %@." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите порт от %@ до %@."
          }
        }
      }
    },
    "Enter addresses like 10.0.0.2/32, separated by commas." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите адреса вида 10.0.0.2/32 через запятую."
          }
        }
      }
    },
    "Enter an MTU from %@ to %@." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите MTU от %@ до %@."
          }
        }
      }
    },
    "Enter seconds from %@ to %@, or 0 to turn it off." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите число секунд от %@ до %@ или 0, чтобы выключить."
          }
        }
      }
    },
    "Line %lld" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Строка %lld"
          }
        }
      }
    },
    "The [Interface] section is missing." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет секции [Interface]."
          }
        }
      }
    },
    "The configuration has no peers." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В конфигурации нет пиров."
          }
        }
      }
    },
    "The configuration is invalid." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Конфигурация неверна."
          }
        }
      }
    },
    "The configuration is too large." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Конфигурация слишком большая."
          }
        }
      }
    },
    "The interface has no addresses." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У интерфейса нет адресов."
          }
        }
      }
    },
    "The private key is missing." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет приватного ключа."
          }
        }
      }
    },
    "The value of %@ is invalid." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неверное значение %@."
          }
        }
      }
    },
    "There is more than one [Interface] section." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Секция [Interface] указана больше одного раза."
          }
        }
      }
    },
    "This line is not a section, a key with a value or a comment." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Строка не похожа ни на секцию, ни на параметр со значением, ни на комментарий."
          }
        }
      }
    },
    "Two peers have the same public key." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У двух пиров одинаковый публичный ключ."
          }
        }
      }
    },
    "Unknown key %@." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неизвестный параметр %@."
          }
        }
      }
    },
    "Unknown section [%@]." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неизвестная секция [%@]."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
