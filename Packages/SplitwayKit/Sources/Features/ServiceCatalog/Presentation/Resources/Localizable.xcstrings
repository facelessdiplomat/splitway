{
  "sourceLanguage" : "en",
  "strings" : {
    "AI Assistants" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ИИ-ассистенты"
          }
        }
      }
    },
    "Add Service" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавить сервис"
          }
        }
      }
    },
    "After you turn off the VPN, apps connect directly again. Apps with their own address cache may keep using the reserved addresses for up to a minute." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После выключения VPN приложения снова подключаются напрямую. Приложения со своим кэшем адресов могут ещё до минуты обращаться к служебным адресам."
          }
        }
      }
    },
    "Apps that connect to built-in addresses use the tunnel only for addresses in the networks of the service." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложения со встроенными адресами идут через туннель, только если эти адреса входят в сети сервиса."
          }
        }
      }
    },
    "Apps that look up names on their own or connect to built-in addresses can bypass the domain rules." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложения, которые сами ищут адреса или подключаются к встроенным адресам, могут обойти правила доменов."
          }
        }
      }
    },
    "Apps that look up names on their own, for example over DNS over HTTPS, bypass the domain rules. Only the networks of the service reach the tunnel." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложения, которые сами ищут адреса, например через DNS over HTTPS, обходят правила доменов. В туннель попадают только сети сервиса."
          }
        }
      }
    },
    "Calls and video chats often connect to addresses that the app learns during the call and may bypass the tunnel." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звонки и видеочаты часто подключаются к адресам, которые приложение узнаёт во время звонка, и могут идти мимо туннеля."
          }
        }
      }
    },
    "Cancel" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отменить"
          }
        }
      }
    },
    "Can’t Delete the Service" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось удалить сервис"
          }
        }
      }
    },
    "Can’t Save the Service" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сохранить сервис"
          }
