{
  "sourceLanguage" : "en",
  "strings" : {
    "Allow camera access in Settings to scan QR codes, or choose a photo." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите доступ к камере в Настройках, чтобы сканировать QR-коды, или выберите фото."
          }
        }
      }
    },
    "Already in the library as “%@”" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже есть в библиотеке как «%@»"
          }
        }
      }
    },
    "Camera access is restricted" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к камере ограничен"
          }
        }
      }
    },
    "Camera scanning is unavailable" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сканирование камерой недоступно"
