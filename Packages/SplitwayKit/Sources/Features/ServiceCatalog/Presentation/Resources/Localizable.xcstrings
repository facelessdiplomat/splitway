        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новый сервис"
          }
        }
      }
    },
    "No Results" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ничего не найдено"
          }
        }
      }
    },
    "No service matches “%@”." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет сервисов по запросу «%@»."
          }
        }
      }
    },
    "None" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет"
          }
        }
      }
    },
    "OK" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ОК"
          }
        }
      }
    },
    "One per line, for example example.com. Subdomains are included." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По одному в строке, например example.com. Поддомены тоже входят."
          }
        }
      }
    },
    "Optional. One per line, for example 203.0.113.0/24." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Необязательно. По одной в строке, например 203.0.113.0/24."
          }
        }
      }
    },
    "Save" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранить"
          }
        }
      }
    },
    "Search Services" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поиск сервисов"
          }
        }
      }
    },
    "Service Routing" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбор сервисов"
          }
        }
      }
    },
    "Service name" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Название сервиса"
          }
        }
      }
    },
    "Services Through the Tunnel" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервисы через туннель"
          }
        }
      }
    },
    "Services Unavailable" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервисы недоступны"
          }
        }
      }
    },
    "Services on shared content networks can be chosen only by domain." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервисы на общих сетях доставки контента можно выбрать только по доменам."
          }
        }
      }
    },
    "Social" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Соцсети"
          }
        }
      }
    },
    "Some networks of %@ are outside the tunnel’s Allowed IPs and won’t use the tunnel." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Часть сетей сервиса «%@» не входит в разрешённые IP туннеля и пойдёт мимо него."
          }
        }
      }
    },
    "Splitway couldn’t change your services. Try again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Splitway не удалось изменить ваши сервисы. Попробуйте ещё раз."
          }
        }
      }
    },
    "Splitway couldn’t read the list of services." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Splitway не удалось прочитать список сервисов."
          }
        }
      }
    },
    "Splitway sends only the DNS queries for the domains of the chosen services to the tunnel and answers them with addresses from a reserved range. Connections to those addresses go through the tunnel to the real servers. Networks that a service publishes go through the tunnel directly. Everything else uses your network as usual." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Splitway отправляет в туннель только DNS-запросы доменов выбранных сервисов и отвечает на них адресами из служебного диапазона. Соединения с этими адресами идут через туннель к настоящим серверам. Сети, которые сервис публикует сам, идут через туннель напрямую. Остальной трафик идёт через вашу сеть как обычно."
          }
        }
      }
    },
    "Subdomains are included." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поддомены тоже входят."
          }
        }
      }
    },
    "The DNS server %@ is outside the tunnel’s Allowed IPs, so the domains of the chosen services won’t resolve." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DNS-сервер %@ не входит в разрешённые IP туннеля, поэтому адреса выбранных сервисов не найдутся."
          }
        }
      }
    },
    "The tunnel’s Allowed IPs don’t include 0.0.0.0/0, so the server may not pass the traffic of the chosen services." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В разрешённых IP туннеля нет 0.0.0.0/0, поэтому сервер может не пропустить трафик выбранных сервисов."
          }
        }
      }
    },
    "The tunnel’s addresses overlap the range Splitway uses for services, so some addresses may not work." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адреса туннеля пересекаются с диапазоном, который Splitway использует для сервисов, поэтому часть адресов может не работать."
          }
        }
      }
    },
    "Video" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видео"
          }
        }
      }
    },
    "Work" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работа"
          }
        }
      }
    },
    "Your Services" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши сервисы"
          }
        }
      }
    },
    "“%@” is not a domain name." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» — не доменное имя."
          }
        }
      }
    },
    "“%@” is not a network. Use a form like 10.0.0.0/8." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» — не сеть. Укажите сеть в виде 10.0.0.0/8."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
